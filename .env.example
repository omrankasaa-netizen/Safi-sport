# ── Backend ─────────────────────────────────────────────────────
APP_SECRET=               # Secret used for session JWT signing (required)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)
PORT=3000                 # HTTP port for the production server

# ── Staff access ────────────────────────────────────────────────
SAFI_OWNER_EMAIL=         # Store owner's email — seeded into staff_roles as "owner"
SAFI_ADMIN_ALLOWED_EMAILS=# Comma-separated staff emails allowed to sign in to the admin panel

# ── Staff Google Sign-In (admin panel) ──────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=    # Same Client ID, exposed to the browser (safe — not secret)

# ── Meta Pixel + Conversions API ────────────────────────────────
SAFI_META_PIXEL_ID=
SAFI_META_CAPI_ACCESS_TOKEN=
SAFI_META_TEST_EVENT_CODE=

# ── RBMsoft integration ─────────────────────────────────────────
SAFI_RBMSOFT_DRIVER=mock  # "mock" (default) or "http" once the real API is known
SAFI_RBMSOFT_BASE_URL=
SAFI_RBMSOFT_API_KEY=
SAFI_RBMSOFT_ITEMS_PATH=/items
SAFI_RBMSOFT_STOCK_PATH=/stock
SAFI_RBMSOFT_SALE_PATH=/sales
SAFI_RBMSOFT_WEBHOOK_SECRET=  # shared secret checked on POST /webhooks/rbmsoft/stock
SAFI_SYNC_ENABLED=false   # "true" starts the 5-min delta sync + nightly full sync + reservation janitor

# ── Commerce ────────────────────────────────────────────────────
SAFI_DELIVERY_FEE_CENTS=300000  # $3.00 flat delivery fee (pickup is free)
SAFI_CURRENCY=USD

# Public origin used for canonical/OG/sitemap URLs (no trailing slash)
SAFI_SITE_URL=https://your-domain.com

# ── Cloudflare R2 (product photo storage + CDN, optional) ───────
# Without these, uploads fall back to local /uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# ── Transactional email (Resend, optional) ──────────────────────
RESEND_API_KEY=
EMAIL_FROM=               # e.g. "SAFI SPORT <hello@safisport.com>"
SAFI_ADMIN_NOTIFICATION_EMAIL=  # Staff inbox that gets a copy of every new order
